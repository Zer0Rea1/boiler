<section class="page-width section-space">
  <div class="section-heading">
    <p class="eyebrow">The journal</p>
    <h1>{{ blog.title | escape }}</h1>
  </div>
  {% paginate blog.articles by 12 %}
    <div class="product-grid journal-grid">
      {% for article in blog.articles %}
        <article class="product-card">
          {% if article.image %}
            <a class="product-card__image" href="{{ article.url }}" aria-label="{{ article.title | escape }}">
              {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,600,900', sizes: '(min-width: 1024px) 25vw, 50vw', alt: article.image.alt }}
            </a>
          {% endif %}
          <div class="journal-card__body">
            <p class="muted"><time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %d, %Y' }}</time></p>
            <h2 class="journal-card__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
            <p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
            <a class="text-link" href="{{ article.url }}">Read article<span class="sr-only">: {{ article.title | escape }}</span></a>
          </div>
        </article>
      {% else %}
        <p class="empty-state">New stories will appear here soon.</p>
      {% endfor %}
    </div>
    {% if paginate.pages > 1 %}<nav aria-label="Pagination">{{ paginate | default_pagination }}</nav>{% endif %}
  {% endpaginate %}
</section>
