<section class="page-width section-space account-panel">
  <h1>A fresh start.</h1>
  <p class="muted">Choose a new password for your account.</p>
  {% form 'reset_customer_password' %}
    <div role="alert">{{ form.errors | default_errors }}</div>
    <label for="ResetPassword">New password</label>
    <input class="field" id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
    <label for="ResetPasswordConfirmation">Confirm new password</label>
    <input class="field" id="ResetPasswordConfirmation" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
    <button class="button" type="submit">Reset password</button>
  {% endform %}
</section>
