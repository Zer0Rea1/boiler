{% comment %}Legacy customer accounts only; new customer accounts are hosted by Shopify.{% endcomment %}
<section class="page-width section-space account-layout">
  <div class="account-panel">
    <h1>Welcome back.</h1>
    <p class="muted">A little space for your everyday care.</p>
    {% form 'customer_login' %}
      <div role="alert">{{ form.errors | default_errors }}</div>
      <label for="CustomerEmail">Email address</label>
      <input class="field" id="CustomerEmail" type="email" name="customer[email]" value="{{ form.email | escape }}" autocomplete="email" required>
      <label for="CustomerPassword">Password</label>
      <input class="field" id="CustomerPassword" type="password" name="customer[password]" autocomplete="current-password" required>
      <button class="button" type="submit">Sign in</button>
    {% endform %}
    <p><a class="text-link" href="#recover">Forgot your password?</a></p>
    <p>New here? <a class="text-link" href="{{ routes.account_register_url }}">Create an account</a></p>
  </div>
  <div class="account-panel" id="recover">
    <h2>A fresh start.</h2>
    <p class="muted">Enter your email and we'll send you a password reset link.</p>
    {% form 'recover_customer_password' %}
      <div role="alert">{{ form.errors | default_errors }}</div>
      {% if form.posted_successfully? %}<p role="status">Check your inbox for your password reset link.</p>{% endif %}
      <label for="RecoverEmail">Email address</label>
      <input class="field" id="RecoverEmail" type="email" name="email" autocomplete="email" required>
      <button class="button button--outline" type="submit">Send reset link</button>
    {% endform %}
  </div>
</section>
