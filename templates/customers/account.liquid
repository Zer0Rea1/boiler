<section class="page-width section-space">
  <div class="section-heading"><h1>Your account.</h1><p>Welcome back, {{ customer.first_name | default: customer.name | escape }}.</p><a class="text-link" href="{{ routes.account_logout_url }}">Sign out</a></div>
  <div class="account-layout">
    <div>
      <h2>Your orders</h2>
      {% paginate customer.orders by 10 %}
        {% for order in customer.orders %}
          <article class="account-order">
            <h3><a class="text-link" href="{{ order.customer_url }}">Order {{ order.name | escape }}</a></h3>
            <p>{{ order.created_at | date: '%B %d, %Y' }} / {{ order.total_price | money_with_currency }}</p>
            <p class="muted">{{ order.financial_status_label | escape }} / {{ order.fulfillment_status_label | escape }}</p>
          </article>
        {% else %}
          <div class="empty-state"><p>Your first ritual is waiting.</p><a class="button" href="{{ routes.all_products_collection_url }}">Explore skincare</a></div>
        {% endfor %}
        {% if paginate.pages > 1 %}<nav aria-label="Pagination">{{ paginate | default_pagination }}</nav>{% endif %}
      {% endpaginate %}
    </div>
    <aside>
      <h2>Your details</h2>
      <p>{{ customer.name | escape }}</p>
      <p>{{ customer.email | escape }}</p>
      {% if customer.default_address %}{{ customer.default_address | format_address }}{% endif %}
      <a class="text-link" href="{{ routes.account_addresses_url }}">Manage addresses ({{ customer.addresses_count }})</a>
    </aside>
  </div>
</section>
