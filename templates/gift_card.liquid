{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Gift card | {{ shop.name | escape }}</title>
    {{ content_for_header }}
    {{ 'tailwind.css' | asset_url | stylesheet_tag }}
  </head>
  <body>
    <main class="page-width section-space gift-card-page">
      <a class="wordmark" href="{{ shop.url }}">{{ shop.name | escape }}</a>
      <section class="empty-state" aria-labelledby="GiftCardHeading">
        <p class="eyebrow">A little care, just for you</p>
        <h1 id="GiftCardHeading">Your gift card</h1>
        <p>Original value: {{ gift_card.initial_value | money_with_currency }}</p>
        <h2>Balance: {{ gift_card.balance | money_with_currency }}</h2>
        {% if gift_card.enabled %}
          {% if gift_card.expired %}
            <p>This gift card has expired.</p>
          {% elsif gift_card.balance == 0 %}
            <p>This gift card has been fully redeemed.</p>
          {% else %}
            <p>Use this code at checkout:</p>
            <p><code class="gift-card-code">{{ gift_card.code | format_code | escape }}</code></p>
            {% if gift_card.expires_on %}<p>Expires {{ gift_card.expires_on | date: '%B %d, %Y' }}</p>{% endif %}
            <p class="muted">Keep your gift card code private.</p>
            <a class="button" href="{{ shop.url }}">Start shopping</a>
          {% endif %}
        {% else %}
          <p>This gift card is disabled. Please contact the store for help.</p>
        {% endif %}
      </section>
    </main>
  </body>
</html>
