<section class="page-width section-space">
  <h1>Find your everyday essentials</h1>
  <form action="{{ routes.search_url }}" method="get" role="search">
    <label for="Search">Search skincare</label>
    <input class="field" id="Search" name="q" type="search" value="{{ search.terms | escape }}" placeholder="Search products" required>
    <input type="hidden" name="type" value="product">
    <button class="button" type="submit">Search</button>
  </form>
  {% if search.performed %}
    <h2>Results for “{{ search.terms | escape }}”</h2>
    {% paginate search.results by 16 %}
      <div class="product-grid" data-reveal>
        {% for result in search.results %}
          {% if result.object_type == 'product' %}
            {% render 'product-card', product: result %}
          {% else %}
            <article><h3><a href="{{ result.url }}">{{ result.title | escape }}</a></h3></article>
          {% endif %}
        {% else %}
          <p class="empty-state">No matches yet. Try another search.</p>
        {% endfor %}
      </div>
      {% if paginate.pages > 1 %}<nav aria-label="Search pages">{{ paginate | default_pagination }}</nav>{% endif %}
    {% endpaginate %}
  {% endif %}
</section>
