{{ 'product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product.js' | asset_url }}" defer></script>
{% assign current_variant = product.selected_or_first_available_variant %}
<section class="page-width section-space" data-product-root data-current-variant="{{ current_variant.id }}">
  <a class="text-link" href="{{ routes.all_products_collection_url }}">{% render 'icon', name: 'arrow-left' %}Back to shop</a>
  <div class="product-layout">
    <div class="product-gallery" aria-label="Product images">
      <div class="product-slider" data-product-track tabindex="0" aria-label="Product image gallery. Swipe or use the arrow keys to browse.">
        {% for image in product.images %}
          <div class="product-slide" data-image-id="{{ image.id }}">
            {% assign image_alt = image.alt | default: product.title %}
            {% if forloop.first %}
              {{ image | image_url: width: 1400 | image_tag: widths: '480,800,1100,1400', sizes: '(min-width: 768px) 55vw, 100vw', loading: 'eager', alt: image_alt }}
            {% else %}
              {{ image | image_url: width: 1400 | image_tag: widths: '480,800,1100,1400', sizes: '(min-width: 768px) 55vw, 100vw', loading: 'lazy', alt: image_alt }}
            {% endif %}
          </div>
        {% else %}
          <div class="product-slide">{{ 'product-1' | placeholder_svg_tag: 'placeholder-image' }}</div>
        {% endfor %}
      </div>
      {% if product.images.size > 1 %}
        <div class="product-gallery-controls" data-product-controls hidden>
          <button class="button button--outline icon-button" type="button" data-product-prev aria-label="Previous product image">{% render 'icon', name: 'arrow-left' %}</button>
          <span data-product-position aria-live="polite">1 / {{ product.images.size }}</span>
          <button class="button button--outline icon-button" type="button" data-product-next aria-label="Next product image">{% render 'icon', name: 'arrow-right' %}</button>
        </div>
        <div class="product-thumbnails" data-product-controls hidden>
          {% for image in product.images %}
            {% assign image_alt = image.alt | default: product.title %}
            <button type="button" class="product-thumbnail" data-product-thumb="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}: {{ image_alt | escape }}" {% if forloop.first %}aria-current="true"{% endif %}>
              {{ image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>
    <div class="product-info">
      {% if product.type != blank %}<p class="eyebrow">{{ product.type | escape }}</p>{% endif %}
      <h1>{{ product.title | escape }}</h1>
      <p class="product-price" aria-live="polite">
        <s class="muted" data-product-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ current_variant.compare_at_price | money_with_currency }}</s>
        <span data-product-price>{{ current_variant.price | money_with_currency }}</span>
      </p>
      {% unless product.has_only_default_variant %}
        <form action="{{ product.url }}" method="get" data-product-options>
          <fieldset class="product-variants">
            <legend>Choose your option</legend>
            <div class="product-variant-options">
              {% for variant in product.variants %}
                <label class="product-variant" for="Variant-{{ section.id }}-{{ variant.id }}">
                  <input type="radio" name="variant" id="Variant-{{ section.id }}-{{ variant.id }}" value="{{ variant.id }}" {% if variant.id == current_variant.id %}checked{% endif %}>
                  <span>{{ variant.title | escape }}{% unless variant.available %}<small>Sold out</small>{% endunless %}</span>
                </label>
              {% endfor %}
            </div>
          </fieldset>
          <noscript><button class="button button--outline" type="submit">Select option</button></noscript>
        </form>
      {% endunless %}
      {% form 'product', product %}
        {{ form.errors | default_errors }}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-product-id>
        <label for="Quantity-{{ section.id }}">Quantity</label>
        <input class="field" id="Quantity-{{ section.id }}" name="quantity" type="number" value="{{ current_variant.quantity_rule.min }}" min="{{ current_variant.quantity_rule.min }}" step="{{ current_variant.quantity_rule.increment }}" {% if current_variant.quantity_rule.max != null %}max="{{ current_variant.quantity_rule.max }}"{% endif %} data-product-quantity required>
        <button class="button" type="submit" data-product-add {% unless current_variant.available %}disabled{% endunless %}>
          {% if current_variant.available %}Add to bag{% else %}Sold out{% endif %}
        </button>
      {% endform %}
      <p class="product-option-status" data-product-status role="status"></p>
      <div class="prose">{{ product.description }}</div>
      {% if shop.shipping_policy.body != blank %}
        <details><summary>Shipping</summary><div class="prose">{{ shop.shipping_policy.body }}</div></details>
      {% endif %}
      {% if shop.refund_policy.body != blank %}
        <details><summary>Returns</summary><div class="prose">{{ shop.refund_policy.body }}</div></details>
      {% endif %}
    </div>
  </div>
  <script type="application/json" data-product-variants>
    [
      {% for variant in product.variants %}
        {
          "id": {{ variant.id | json }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price | money_with_currency | json | replace: '<', '\u003c' }},
          "compareAt": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money_with_currency | json | replace: '<', '\u003c' }}{% else %}null{% endif %},
          "imageId": {{ variant.featured_image.id | json }},
          "quantity": {{ variant.quantity_rule | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  </script>
</section>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
