<section class="hero page-width">
  <div class="hero-copy">
    <p class="eyebrow">A little care. A little more you.</p>
    <h1>{{ section.settings.heading | escape }}</h1>
    <p class="hero-description">{{ section.settings.description | escape }}</p>
    <div><a class="button" href="{{ routes.all_products_collection_url }}">Find your everyday care {% render 'icon', name: 'arrow-up-right' %}</a></div>
  </div>
  <div class="hero-visual">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1800 | image_tag: widths: '480,800,1200,1800', sizes: '(min-width: 768px) 55vw, 100vw', loading: 'eager', fetchpriority: 'high' }}
    {% else %}
      <img src="{{ 'beauty-editorial.jpg' | asset_url }}" width="1600" height="1067" alt="A face mask being gently applied during a skincare ritual" fetchpriority="high">
    {% endif %}
  </div>
</section>
<div class="care-note page-width"><span>Less noise.</span><span>More care.</span><span>Entirely you.</span></div>
<section class="page-width section-space" aria-labelledby="ShopHeading">
  <div class="section-heading" data-reveal>
    <h2 id="ShopHeading">Meet your daily ritual.</h2>
    <p>Make a little room for the things that make you feel good.</p>
  </div>
  {% assign featured_collection = section.settings.collection | default: collections.all %}
  {% if featured_collection.products.size > 0 %}
    <div class="product-grid" data-reveal>
      {% for product in featured_collection.products limit: 4 %}
        {% render 'product-card', product: product %}
      {% endfor %}
    </div>
    <div class="section-action"><a class="text-link" href="{{ featured_collection.url }}">Explore the collection {% render 'icon', name: 'arrow-up-right' %}</a></div>
  {% else %}
    <div class="empty-state"><p>Your next everyday favorite is on its way.</p><p class="muted">Our collection will be here soon.</p></div>
  {% endif %}
</section>
<section class="approach page-width section-space" id="approach">
  <div class="approach-title" data-reveal><p class="eyebrow">The morrow approach</p><h2>Good skin days.<br>At your own pace.</h2></div>
  <div class="approach-body" data-reveal><p class="statement">Care should feel like a moment for yourself. Never another thing to get right.</p><p>We believe in a routine that fits your life. A few considered essentials, a little consistency, and space to enjoy the everyday.</p><a class="text-link" href="{{ routes.all_products_collection_url }}">Make it your ritual {% render 'icon', name: 'arrow-up-right' %}</a></div>
</section>
<section class="questions page-width section-space" id="questions" aria-labelledby="QuestionsHeading">
  <div data-reveal><h2 id="QuestionsHeading">A little clarity.</h2><p class="muted">Because your routine should be the easy part.</p></div>
  <div class="question-list" data-reveal>
    <details><summary>Where should I start?</summary><p>Start with your everyday essentials: a cleanser, a moisturizer, and daytime sun protection. Explore the product details to find what fits your routine.</p></details>
    <details><summary>How do I introduce a new product?</summary><p>Introduce one product at a time and follow its directions. Patch test before first use and stop using a product if irritation occurs.</p></details>
    <details><summary>Where can I find ingredients and directions?</summary><p>Check the individual product page and packaging for ingredients, directions, and care information.</p></details>
    {% if shop.shipping_policy.body != blank %}<details><summary>What are your shipping options?</summary><div class="prose">{{ shop.shipping_policy.body }}</div></details>{% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Skincare homepage",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Your skin. Your kind of care."},
    {"type":"text","id":"description","label":"Description","default":"Everyday skincare for a ritual that feels as good as it looks."},
    {"type":"image_picker","id":"image","label":"Campaign image"},
    {"type":"collection","id":"collection","label":"Featured collection"}
  ],
  "presets": [{"name":"Skincare homepage"}]
}
{% endschema %}
