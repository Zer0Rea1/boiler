<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name | escape }} | Opening soon</title>
    {{ content_for_header }}
    {{ 'tailwind.css' | asset_url | stylesheet_tag }}
  </head>
  <body>
    <main class="password-page page-width section-space" id="MainContent">
      <p class="wordmark">{{ shop.name | escape }}</p>
      <h1>A little care is on its way.</h1>
      {% if shop.password_message != blank %}
        <div class="prose">{{ shop.password_message }}</div>
      {% endif %}
      {{ content_for_layout }}
      {% form 'storefront_password', class: 'password-form' %}
        {{ form.errors | default_errors }}
        <label for="StorefrontPassword">Store password</label>
        <input class="field" id="StorefrontPassword" type="password" name="password" autocomplete="current-password" required>
        <button class="button" type="submit">Enter store</button>
      {% endform %}
    </main>
  </body>
</html>
